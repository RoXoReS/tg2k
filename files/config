# ==============================================================================
# Конфигурация автономного Telegram-туннеля (вырезано из z2k)
# ==============================================================================

# --- Управление туннелем ---
# 0 — туннель работает (автозапуск разрешен)
# 1 — туннель принудительно выключен (если вы нажали "Стоп" в меню/панели)
TG_PROXY_USER_DISABLED=0

# --- Настройки релея ---
# Если эти строки закомментированы (стоит #), туннель будет использовать 
# адрес и секрет, которые зашиты в сам бинарник tg-mtproxy-client.
#
# Если вы хотите сменить сервер (например, переехал релей), 
# раскомментируйте строки ниже и укажите новые значения:

# Z2K_RELAY_URL=wss://85.192.60.175.nip.io/ws
# Z2K_RELAY_SECRET=ваш_новый_секрет_если_он_изменился